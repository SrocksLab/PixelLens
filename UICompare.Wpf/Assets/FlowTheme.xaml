<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="FlowText" Color="#EEF3FD"/><SolidColorBrush x:Key="FlowMuted" Color="#A9BBD5"/>
 <LinearGradientBrush x:Key="FlowAccent" StartPoint="0,0" EndPoint="1,.36"><GradientStop Color="#6F43D6" Offset="0"/><GradientStop Color="#3858C9" Offset=".55"/><GradientStop Color="#08778F" Offset="1"/></LinearGradientBrush>
 <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#EEF3FD"/></Style>
 <Style TargetType="Button">
  <Setter Property="Background" Value="#1D2B41"/><Setter Property="Foreground" Value="#EDF3FD"/><Setter Property="BorderBrush" Value="#394B65"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="14,0"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".88"/><Setter TargetName="Surface" Property="BorderBrush" Value="#657C9F"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#202C3E"/><Setter Property="Foreground" Value="#8998B0"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DD9F0"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FlowPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource FlowAccent}"/><Setter Property="BorderBrush" Value="#A491ED25"/><Setter Property="Foreground" Value="White"/></Style>
 <Style TargetType="TextBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#E9F0FF"/><Setter Property="Background" Value="#0D182B"/><Setter Property="BorderBrush" Value="#3B4E6C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</ResourceDictionary>