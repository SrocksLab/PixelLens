<Window x:Class="UICompare.Wpf.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Icon="/UICompare;component/app.ico" Title="PixelLens · 像素之眼" Width="1380" Height="800" MinWidth="940" MinHeight="580"
 Background="#000000" Foreground="#E4EBF8" FontFamily="Microsoft YaHei UI" FontSize="14"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
 UseLayoutRounding="True" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#8048EE" Offset="0"/><GradientStop Color="#426DEC" Offset=".55"/><GradientStop Color="#08B4D0" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E3EAFA"/><Setter Property="Background" Value="#1F2E43"/><Setter Property="BorderBrush" Value="#35445A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A3B55"/><Setter TargetName="Surface" Property="BorderBrush" Value="#5D6F8D"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18263B"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8998B0"/><Setter TargetName="Surface" Property="Background" Value="#202C3E"/><Setter TargetName="Surface" Property="BorderBrush" Value="#344159"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DD9F0"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".90"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#202C3E"/><Setter Property="Foreground" Value="#8998B0"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DD9F0"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="20"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#92A2BD"/>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="20"><Thumb.Template><ControlTemplate><Border Background="#344765" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollViewer">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
     <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource {x:Type ScrollBar}}" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="FontSize" Value="{DynamicResource FooterFontSize}"/><Setter Property="Padding" Value="{DynamicResource FooterButtonPadding}"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}"><ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" Padding="{TemplateBinding Padding}" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,10,8,0"/><Setter Property="Foreground" Value="#E0E7F5"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="80"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#162336"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#1C2B42"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#252849"/><Setter TargetName="Card" Property="BorderBrush" Value="#7562D2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CloseSurface" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#C42B1C"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#A62318"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Tab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#94A6C2"/><Setter Property="FontSize" Value="18"/><Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid>
    <Border x:Name="TabBg" CornerRadius="4" Background="Transparent"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border x:Name="Line" Height="2" Background="#8A67EF" VerticalAlignment="Bottom" Visibility="Collapsed"/>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBg" Property="Background" Value="#1C2339"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabBg" Property="Background" Value="#2A2F4F"/><Setter TargetName="Line" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#E6DEFB"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Width" Value="88"/><Setter Property="Height" Value="24"/><Setter Property="Foreground" Value="#927AFF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center">
    <Border Height="4" Background="#41516B" VerticalAlignment="Center"/>
    <Track x:Name="PART_Track">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="#927AFF"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate><Ellipse Fill="#927AFF"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="DesignTemplate">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource ThumbColumn}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
    <Image x:Name="Thumb" Source="{Binding Design.Image}" Width="{DynamicResource ThumbWidth}" Height="{DynamicResource ThumbHeight}" Stretch="UniformToFill"/>
    <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource RowTextMargin}">
     <TextBlock Text="{Binding Design.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Design.Name}" FontSize="{DynamicResource RowNameSize}"/>
     <TextBlock Text="{Binding Design.Size}" Foreground="#94A4BF" FontFamily="Segoe UI" FontSize="{DynamicResource RowSizeFont}" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="Delete_Click" Tag="design" ToolTip="删除设计稿及对应截图">
     <Viewbox Width="18" Height="18" Stretch="Uniform"><Canvas Width="20" Height="20"><Path Data="{StaticResource DeleteGeometry}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
    </Button>
    <TextBlock x:Name="Missing" Grid.ColumnSpan="2" Text="暂无对应设计稿" Foreground="#8F9FBA" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding HasDesign}" Value="False"><Setter TargetName="Thumb" Property="Visibility" Value="Collapsed"/><Setter TargetName="Info" Property="Visibility" Value="Collapsed"/><Setter TargetName="Missing" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ShotTemplate">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="{DynamicResource ThumbColumn}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
    <Button x:Name="Grip" Style="{StaticResource IconButton}" Width="12" Height="32" Cursor="Hand" PreviewMouseLeftButtonDown="Grip_Down" PreviewMouseMove="Grip_Move" ToolTip="拖动截图重新配对">
     <Viewbox Width="10" Height="20" Stretch="Uniform"><Canvas Width="20" Height="20"><Path Data="{StaticResource GripGeometry}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
    </Button>
    <Image x:Name="Thumb" Grid.Column="1" Source="{Binding Shot.Image}" Width="{DynamicResource ThumbWidth}" Height="{DynamicResource ThumbHeight}" Stretch="UniformToFill"/>
    <StackPanel x:Name="Info" Grid.Column="2" VerticalAlignment="Center" Margin="{DynamicResource RowTextMargin}">
     <TextBlock Text="{Binding Shot.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Shot.Name}" FontSize="{DynamicResource RowNameSize}"/>
     <TextBlock Text="{Binding Shot.Size}" Foreground="#94A4BF" FontFamily="Segoe UI" FontSize="{DynamicResource RowSizeFont}" Margin="0,4,0,0"/>
    </StackPanel>
    <Button x:Name="DeleteShot" Grid.Column="3" Style="{StaticResource IconButton}" Click="Delete_Click" Tag="shot" ToolTip="删除截图">
     <Viewbox Width="18" Height="18" Stretch="Uniform"><Canvas Width="20" Height="20"><Path Data="{StaticResource DeleteGeometry}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
    </Button>
    <TextBlock x:Name="Missing" Grid.ColumnSpan="3" Text="暂无对应截图" Foreground="#8F9FBA" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding HasShot}" Value="False"><Setter TargetName="DeleteShot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Grip" Property="Visibility" Value="Collapsed"/><Setter TargetName="Thumb" Property="Visibility" Value="Collapsed"/><Setter TargetName="Info" Property="Visibility" Value="Collapsed"/><Setter TargetName="Missing" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#010818"><Grid>
   <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"><Image Source="/UICompare;component/Assets/logo-header.png" Width="32" Height="32"/><TextBlock Text="像素之眼" FontSize="14" FontWeight="SemiBold" Foreground="#929BAD" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化"><Viewbox Width="16" Height="16" Stretch="Uniform"><Canvas Width="16" Height="16"><Path Data="{StaticResource MinimizeGeometry}" Fill="#B1BFD4"/></Canvas></Viewbox></Button>
    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化或还原"><Viewbox Width="16" Height="16" Stretch="Uniform"><Canvas Width="16" Height="16"><Path x:Name="MaximizeIcon" Data="{StaticResource MaximizeGeometry}" Fill="#B1BFD4"/></Canvas></Viewbox></Button>
    <Button Style="{StaticResource CaptionClose}" Click="Close_Click" ToolTip="关闭"><Viewbox Width="16" Height="16" Stretch="Uniform"><Canvas Width="16" Height="16"><Path Data="{StaticResource CloseGeometry}" Fill="#B1BFD4"/></Canvas></Viewbox></Button>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" x:Name="Body">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightColumn" Width="300"/></Grid.ColumnDefinitions>
   <Border Background="#101B2D" BorderBrush="#1F2D43" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border BorderBrush="#223047" BorderThickness="0,0,0,1"><Grid Margin="20,0"><TextBlock Text="设计稿" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="DesignCount" Text="0 张" FontSize="12" Foreground="#94A4BF" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
     <ListBox x:Name="DesignList" Grid.Row="1" ItemTemplate="{StaticResource DesignTemplate}" PreviewMouseLeftButtonDown="DesignList_PreviewDown" SelectionChanged="List_SelectionChanged" ScrollViewer.ScrollChanged="List_ScrollChanged"/>
     <StackPanel x:Name="DesignEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="/UICompare;component/Assets/empty-design.png" Width="144" Height="104" Margin="0,0,0,8"/>
      <TextBlock Text="暂无设计稿" Foreground="#A7B6CD" HorizontalAlignment="Center"/>
      <TextBlock Text="支持一次导入多张图片" Foreground="#8F9FBA" FontSize="12" Margin="0,10,0,20" HorizontalAlignment="Center"/>
      <Button Style="{StaticResource FooterButton}" Content="导入设计稿" Width="150" Click="ImportDesign_Click"/>
     </StackPanel>
     <Border x:Name="DesignFooter" Grid.Row="2" BorderBrush="#26354D" BorderThickness="0,1,0,0" Padding="10,9" Height="60"><Button Style="{StaticResource FooterButton}" Content="导入设计稿" Click="ImportDesign_Click"/></Border>
    </Grid>
   </Border>
   <Grid Grid.Column="1" x:Name="Center" Background="Black">
    <Grid.RowDefinitions><RowDefinition x:Name="ViewRow" Height="170"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="158"/></Grid.RowDefinitions>
    <Grid>
     <Border x:Name="TabBar" Width="400" Height="40" Background="#0C121E" CornerRadius="9" VerticalAlignment="Top" Margin="12,70,12,0"><UniformGrid Columns="4">
      <RadioButton x:Name="DesignTab" Content="设计稿" Tag="design" Style="{StaticResource Tab}" GroupName="Views" Checked="View_Checked" IsChecked="True"/>
      <RadioButton x:Name="ShotTab" Content="截图" Tag="shot" Style="{StaticResource Tab}" GroupName="Views" Checked="View_Checked"/>
      <RadioButton x:Name="OverlayTab" Content="叠加" Tag="overlay" Style="{StaticResource Tab}" GroupName="Views" Checked="View_Checked"/>
      <RadioButton x:Name="DiffTab" Content="差异" Tag="diff" Style="{StaticResource Tab}" GroupName="Views" Checked="View_Checked"/>
     </UniformGrid></Border>
     <TextBlock x:Name="Feedback" Foreground="#94A4BF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="12,123,12,0" VerticalAlignment="Top"/>
    </Grid>
    <Grid Grid.Row="1" x:Name="PreviewHost" Margin="12,0" Background="Black" SizeChanged="Preview_SizeChanged" ClipToBounds="True">
     <Canvas x:Name="LogicalWorkspace" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Canvas x:Name="PixelFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black" ClipToBounds="True" MouseLeftButtonDown="Frame_Down" MouseMove="Frame_Move" MouseLeftButtonUp="Frame_Up" MouseWheel="Frame_Wheel" LostMouseCapture="Frame_LostCapture">
      <Image x:Name="DesignImage" Stretch="Fill" IsHitTestVisible="False"/>
      <Image x:Name="ScreenshotImage" Stretch="Fill" IsHitTestVisible="False"/>
      <Image x:Name="DifferenceImage" Stretch="Fill" IsHitTestVisible="False"/>
     </Canvas>
     <Canvas x:Name="AnchorLayer" IsHitTestVisible="True" Background="{x:Null}">
      <Border x:Name="AnchorMarker" Width="24" Height="24" Cursor="Hand" Background="#18000000" CornerRadius="12" ToolTip="拖动缩放基准点"
        MouseLeftButtonDown="Anchor_Down" MouseMove="Anchor_Move" MouseLeftButtonUp="Anchor_Up" LostMouseCapture="Anchor_Lost">
       <Grid IsHitTestVisible="False"><Ellipse Width="14" Height="14" Fill="#101B2D" Stroke="#E8DEFF" StrokeThickness="1.5"/>
        <Path Data="M12,1 V8 M12,16 V23 M1,12 H8 M16,12 H23" Stroke="#A88BFF" StrokeThickness="1.5"/><Ellipse Width="3" Height="3" Fill="#A88BFF"/></Grid>
      </Border>
     </Canvas>
     <StackPanel x:Name="CenterEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Background="#100C1B" Width="58" Height="58" CornerRadius="14" Margin="0,0,0,24"><Viewbox Width="26" Height="26" Stretch="Uniform"><Canvas Width="20" Height="20"><Path Data="{StaticResource ImageGeometry}" Fill="#A58BE8"/></Canvas></Viewbox></Border>
      <TextBlock x:Name="CenterEmptyTitle" Text="从一张设计稿开始" FontSize="20" Foreground="#E4EBF8" HorizontalAlignment="Center"/>
      <TextBlock Text="导入设计稿 → 捕获截图 → 对齐对比" Foreground="#8F9FBA" Margin="0,12,0,24" FontSize="13" HorizontalAlignment="Center"/>
      <Button Style="{StaticResource Primary}" Content="导入设计稿" Width="150" Click="ImportDesign_Click"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="14,26,14,0" x:Name="ControlsGrid" VerticalAlignment="Top">
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="AlignmentControls" Orientation="Horizontal" VerticalAlignment="Top" Height="40">
      <TextBlock Text="截图透明度" FontSize="11" Foreground="#C5CFDF" VerticalAlignment="Center"/>
      <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="50" Margin="8,0" ValueChanged="Opacity_Changed"/>
      <TextBlock x:Name="OpacityValue" Text="50%" FontFamily="Segoe UI" FontSize="12" Foreground="#D7DFED" Width="34" VerticalAlignment="Center"/>
      <TextBlock Text="截图缩放" FontSize="11" Foreground="#C5CFDF" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <Slider x:Name="ScaleSlider" Minimum="25" Maximum="300" Value="100" Margin="8,0" ValueChanged="Scale_Changed"/>
      <TextBlock x:Name="ScaleValue" Text="100%" FontFamily="Segoe UI" FontSize="12" Foreground="#D7DFED" Width="36" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel x:Name="CompareActions" Orientation="Horizontal" HorizontalAlignment="Right" Height="40">
      <Button x:Name="ResetButton" Content="重置" Width="72" Click="Reset_Click" Margin="0,0,12,0"/>
      <Button x:Name="CompareButton" Content="开始对比" Style="{StaticResource Primary}" Width="132" Click="Compare_Click"/>
     </StackPanel>
    </Grid>
   </Grid>
   <Border Grid.Column="2" Background="#101B2D" BorderBrush="#1F2D43" BorderThickness="1,0,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border BorderBrush="#223047" BorderThickness="0,0,0,1"><Grid Margin="20,0"><TextBlock Text="截图" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock x:Name="ShotCount" Text="0 张" FontSize="12" Foreground="#94A4BF" VerticalAlignment="Center"/></Grid></Border>
     <ListBox x:Name="ShotList" Grid.Row="1" ItemTemplate="{StaticResource ShotTemplate}" SelectionChanged="List_SelectionChanged" ScrollViewer.ScrollChanged="List_ScrollChanged" AllowDrop="True" DragOver="Shot_DragOver" Drop="Shot_Drop"/>
     <StackPanel x:Name="ShotEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="/UICompare;component/Assets/empty-shot.png" Width="144" Height="104" Margin="0,0,0,8"/>
      <TextBlock Text="暂无截图" Foreground="#A7B6CD" HorizontalAlignment="Center"/>
      <TextBlock Text="捕获界面或导入本地截图" Foreground="#8F9FBA" FontSize="12" Margin="0,10,0,20" HorizontalAlignment="Center"/>
      <StackPanel Orientation="Horizontal"><Button Style="{StaticResource FooterButton}" Content="导入截图" Width="{DynamicResource EmptyShotWidth}" Click="ImportShot_Click"/><Button Style="{StaticResource FooterButton}" Content="截图" Width="{DynamicResource EmptyShotWidth}" Margin="10,0,0,0" Click="Capture_Click"/></StackPanel>
     </StackPanel>
     <Border x:Name="ShotFooter" Grid.Row="2" BorderBrush="#26354D" BorderThickness="0,1,0,0" Padding="10,9" Height="60"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Style="{StaticResource FooterButton}" Content="导入截图" Click="ImportShot_Click"/><Button Grid.Column="2" Content="截图" Click="Capture_Click"/>
     </Grid></Border>
    </Grid>
   </Border>
  </Grid>
  <Border x:Name="Toast" Grid.RowSpan="2" Background="#243148" CornerRadius="8" Padding="24,14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,72" Visibility="Collapsed" IsHitTestVisible="False">
   <TextBlock x:Name="ToastText" Foreground="#EDF3FF" TextWrapping="Wrap" FontSize="14"/>
  </Border>
  <Grid x:Name="CaptureModeLayer" Grid.RowSpan="2" Background="#BD030713" Visibility="Collapsed">
   <Border Width="480" Background="#17243A" BorderBrush="#3F4E69" BorderThickness="1" CornerRadius="10" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="捕获截图" FontSize="20" Foreground="#EEF3FD"/><TextBlock Text="请选择截取方式。进入后将隐藏主界面。" FontSize="13" Foreground="#A9BBD5" Margin="0,12,0,22"/>
     <UniformGrid Columns="2"><Button x:Name="FixedCaptureChoice" Background="#21304A" BorderBrush="#4B5971" Height="110" Margin="0,0,6,0" Click="FixedCapture_Click"><StackPanel><TextBlock Text="按设计稿尺寸" HorizontalAlignment="Center"/><TextBlock x:Name="CaptureDesignSize" FontSize="11" Foreground="#9BAFCF" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button Background="#21304A" BorderBrush="#4B5971" Height="110" Margin="6,0,0,0" Click="FreeCapture_Click"><StackPanel><TextBlock Text="自由框选" HorizontalAlignment="Center"/><TextBlock Text="拖出选框，可调整边缘" FontSize="11" Foreground="#9BAFCF" Margin="0,10,0,0"/></StackPanel></Button></UniformGrid>
     <Button Content="取消" Width="80" HorizontalAlignment="Right" Margin="0,24,0,0" Click="CancelCaptureMode_Click"/>
    </StackPanel>
   </Border>
  </Grid>
  <Grid x:Name="DecisionLayer" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
   <Border Background="#101B2D" CornerRadius="10" Width="390" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel><TextBlock x:Name="DecisionTitle" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="DecisionText" TextWrapping="Wrap" Foreground="#94A4BF" Margin="0,16,0,24"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Width="80" Margin="0,0,12,0" Click="DecisionCancel_Click"/><Button x:Name="DecisionConfirm" Content="确认" Width="100" Style="{StaticResource Primary}" Click="DecisionConfirm_Click"/></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>


