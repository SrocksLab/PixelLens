<Window x:Class="UICompare.Wpf.Views.CaptureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Black" ShowInTaskbar="False" Topmost="True" Cursor="Cross">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/UICompare;component/Assets/FlowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid ClipToBounds="True">
  <Image x:Name="ScreenImage" Stretch="Fill" IsHitTestVisible="False"/>
  <Canvas x:Name="OverlayCanvas" Background="Transparent" MouseLeftButtonDown="Canvas_Down" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up" LostMouseCapture="Canvas_Lost">
   <Path x:Name="Shade" Fill="#77020711" IsHitTestVisible="False"/>
   <Rectangle x:Name="SelectionBorder" Stroke="#60C7F5" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
   <Canvas x:Name="Handles" IsHitTestVisible="False"/>
   <Border x:Name="ActionPanel" Background="Transparent" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal"><Button Content="取消" Height="32" FontSize="12" Padding="12,0" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="确认截取" Height="32" FontSize="12" Padding="12,0" Style="{StaticResource FlowPrimary}" Click="Confirm_Click"/></StackPanel>
   </Border>
   <TextBlock x:Name="SizeText" FontSize="11" Foreground="#E9F2FF" Background="#DE091426" Padding="9,5" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Canvas>
  <Border x:Name="ModePanel" Background="#DE091326" CornerRadius="6" Padding="14,10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" IsHitTestVisible="False"><TextBlock x:Name="CaptureModeText" FontSize="12" Foreground="#C1D0E7"/></Border>
  <Border x:Name="FreeHint" Background="#E60C182F" CornerRadius="6" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="按住鼠标，拖出截取区域" FontSize="13" Foreground="#E5ECFA"/></Border>
  <Border Background="#DE091326" Padding="20,8" VerticalAlignment="Bottom" Height="50" IsHitTestVisible="False"><TextBlock Text="选框内部可拖动，自由框选后可拖边、拖角调整" FontSize="12" Foreground="#94AAC7" VerticalAlignment="Center"/></Border>
  <Button Content="取消截屏" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8" Height="34" Click="Cancel_Click"/>
 </Grid>
</Window>