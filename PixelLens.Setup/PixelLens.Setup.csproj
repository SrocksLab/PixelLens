<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PixelLens-Setup-v1.0.0</AssemblyName>
    <RootNamespace>PixelLens.Setup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>PixelLens · 像素之眼 安装程序</Product>
    <ApplicationIcon>../UICompare.Wpf/app.ico</ApplicationIcon>
    <ApplicationManifest>../UICompare.Wpf/app.manifest</ApplicationManifest>
    <SetupEnginePath Condition="'$(SetupEnginePath)' == ''">$(MSBuildThisFileDirectory)../output/releases/v$(Version)/engine/PixelLens-Engine-v$(Version).exe</SetupEnginePath>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="../UICompare.Wpf/Assets/FlowTheme.xaml" Link="FlowTheme.xaml" />
    <Resource Include="../UICompare.Wpf/Assets/logo.png" Link="Assets/logo.png" />
    <Resource Include="../UICompare.Wpf/app.ico" Link="app.ico" />
    <EmbeddedResource Include="$(SetupEnginePath)" LogicalName="SetupEngine" Condition="Exists('$(SetupEnginePath)')" />
  </ItemGroup>
  <Target Name="ValidateSetupEngine" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(SetupEnginePath)')" Text="Setup engine not found: $(SetupEnginePath). Run build.ps1 first or set SetupEnginePath." />
  </Target>
</Project>
